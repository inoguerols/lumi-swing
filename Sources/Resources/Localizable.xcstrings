    "Continuar": {
      "comment": "Único botón del overlay de pausa al volver de segundo plano en plena partida.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        }
