    "¡tu mejor marca!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "new best!"
          }
        }
      }
    },
    "«Ver los muros a ciegas» mantiene la penumbra y la puntuación doble, pero deja los muros con un contorno tenue. Si apagas los hápticos se activa solo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Show walls in blind zones” keeps the dimness and the double score, but leaves the walls with a faint outline. It turns on automatically if you turn off haptics."
          }
        }
      }
    }
  },
  "version": "1.0"
