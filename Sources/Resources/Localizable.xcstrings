    "Lumi Swing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumi Swing"
          }
        }
      }
    },
    "Lumi habla por el tacto:\njuega con el móvil en la mano.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumi speaks through touch:\nplay with your phone in hand."
          }
        }
      }
    },
    "Mantén pulsado para agarrarte a una flor.\nSuelta para salir volando.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to grab onto a flower.\nLet go to fly off."
          }
        }
      }
    },
    "Menú": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu"
