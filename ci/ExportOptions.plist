<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- destination=upload: xcodebuild sube el .ipa a App Store Connect él solo,
	     sin altool ni Transporter. La build aparece en TestFlight al procesarse. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>TC2NNHZ9UU</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
